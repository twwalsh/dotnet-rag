    "FaqPinned": 3,
    "Passages": 8,
    "Sources": 3,
    "SourceMinScore": 0.65,
    "QuestionMaxChars": 500,
    "Embedder": "OpenAI",
    "AzureOpenAI": {
      "Endpoint": null,
      "Deployment": "text-embedding-3-small",
      "UseManagedIdentity": false
    },
    "WorkersAi": {
      "AccountId": null,
      "Model": "@cf/baai/bge-base-en-v1.5",
      "ChatModel": "@cf/meta/llama-3.1-8b-instruct-fp8-fast"
    },
    "OpenAI": {
      "Model": "text-embedding-3-small"
    },
    "IngestHourUtc": 3,
    "IngestOnStartupIfEmpty": true
  }
}
