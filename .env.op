# 1Password references, resolved at run time: `op run --env-file=.env.op -- make run`.
# Nothing in this file is a secret; the values are paths into the vault. Fill the item names in once.
ANTHROPIC_API_KEY=op://Personal/fr-support-chat/key
# CLOUDFLARE_API_TOKEN=op://Personal/<cloudflare-workers-ai-token-item>/credential   # only for Rag__Embedder=WorkersAi
# OPENAI_API_KEY=op://Personal/<openai-api-key-item>/credential                         # only for Rag__Embedder=OpenAI
# AZURE_OPENAI_API_KEY=op://Personal/<azure-openai-item>/credential                   # only for Rag__Embedder=AzureOpenAI without managed identity
# RAG_ADMIN_KEY=op://Personal/<support-rag-admin-key-item>/credential                 # enables POST /admin/ingest; unset = endpoint disabled
# Non-secret settings can live here too (double underscore = configuration section separator)
# Locally the Workers AI token is wrangler's own OAuth token: CLOUDFLARE_API_TOKEN=$(cd ../fruitless-research/site && npx wrangler auth token)
Rag__Embedder=WorkersAi
Rag__WorkersAi__AccountId=17c5062d3635faece7c485f10fe18375
# Rag__Embedder=AzureOpenAI
# Rag__AzureOpenAI__Endpoint=https://<resource>.openai.azure.com/
